{
  "name": "onedocs",
  "version": "0.1.27",
  "type": "module",
  "description": "Zero-config documentation for Next.js + Fumadocs. Install one dependency, write markdown, ship docs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inline0/onedocs.git"
  },
  "bugs": {
    "url": "https://github.com/inline0/onedocs/issues"
  },
  "homepage": "https://onedocs.inline0.dev",
  "keywords": [
    "documentation",
    "docs",
    "nextjs",
    "next",
    "fumadocs",
    "mdx",
    "markdown",
    "react"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "import": "./dist/source/index.js"
    },
    "./llms": {
      "types": "./dist/llms/index.d.ts",
      "import": "./dist/llms/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js"
    },
    "./og": {
      "types": "./dist/og/index.d.ts",
      "import": "./dist/og/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js"
    },
    "./css/preset.css": "./src/css/preset.css"
  },
  "files": [
    "dist",
    "src/css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && node ../../scripts/prepare-declarations.ts",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json && tsc-rs --noEmit -p tsconfig.tests.json",
    "prepack": "pnpm run build && node ../../scripts/prepare-package.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.4.7",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.4.7",
    "lucide-react": "^0.562.0 || ^1.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@onedocs/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsc-rs": "catalog:"
  }
}

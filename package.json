{
  "name": "@onedocs/workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "build": "pnpm -r build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "lint:fix": "oxlint . --fix --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json && pnpm --filter onedocs typecheck",
    "test": "pnpm test:lint-rules && pnpm test:scripts && pnpm --filter onedocs test",
    "test:package": "node scripts/check-package.ts",
    "test:consumer": "node scripts/check-consumer.ts",
    "audit:workspace": "node scripts/check-workspace.ts",
    "audit:docs": "node scripts/check-docs-content.ts --expected-docs 6 --expected-nav 1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:package && pnpm test:consumer",
    "test:lint-rules": "node --test scripts/oxlint-plugins/*.test.ts",
    "test:scripts": "node --test \"scripts/*.test.ts\" \"scripts/lib/*.test.ts\""
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "tsc-rs": "catalog:",
    "effect": "catalog:",
    "@effect/platform-node": "catalog:"
  }
}
